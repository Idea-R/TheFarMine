        "component",
        "consumable"
      ],
      "notes": []
    },
    "stack_size": {
      "name": "stack_size",
      "type": "int",
      "required": true,
      "default": 1,
      "min": 1,
      "max": 999,
      "enum": [],
      "notes": [
        "tools shall have stack_size=1"
      ]
    },
    "weight": {
      "name": "weight",
      "type": "number",
      "required": true,
      "default": 1.0,
      "min": 0.0,
      "max": 100.0,
