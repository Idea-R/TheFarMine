    },
    "value": {
      "name": "value",
      "type": "int",
      "required": true,
      "default": 0,
      "min": 0,
      "max": 100000,
      "enum": [],
      "notes": [
        "shop/currency hooks later"
      ]
    },
    "tags": {
      "name": "tags",
      "type": "array<string>",
      "required": false,
      "default": [],
      "min": 0,
      "max": 32,
      "enum": [],
      "notes": [
        "free-form grouping: ['ore','wood','binding']"
      ]
    }
