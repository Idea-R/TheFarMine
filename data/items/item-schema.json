{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "The Far Mine — Item Schema v1",
  "description": "Strict, loader-safe JSON Schema (draft-07) describing a single Item definition in The Far Mine. Validates tool items (MVP focus) and is forward-ready for materials/consumables. Matches current data/items/tools.json (Starter, Copper, Reinforced picks). Arrays like tools.json should validate each element against this schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "kind",
    "name",
    "description",
    "tags",
    "stack_size",
    "rarity",
    "icon_id"
  ],
  "properties": {
    "version": {
      "type": "integer",
      "enum": [
        1
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
    },
    "kind": {
      "type": "string",
      "enum": [
        "tool",
        "material",
        "consumable",
        "quest"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_\\.:-]+$"
      },
      "uniqueItems": true,
      "maxItems": 16
    },
    "stack_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 999
    },
    "subtype": {
      "type": "string",
      "enum": [
        "pickaxe",
        "drill",
        "ammo",
        "ingot",
        "ore",
        "gem",
        "potion",
        "misc"
      ]
    },
    "tier": {
      "type": "integer",
      "minimum": 0
    },
    "durability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max"
      ],
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100000
        }
      }
    },
    "mining": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "power",
        "speed",
        "stamina_cost"
      ],
      "properties": {
        "power": {
          "type": "number",
          "minimum": 0
        },
        "speed": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "stamina_cost": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "combat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "damage_base",
        "poise_damage"
      ],
      "properties": {
        "damage_base": {
          "type": "integer",
          "minimum": 0
        },
        "poise_damage": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "tool_effects": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "can_mine": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
          },
          "uniqueItems": true,
          "maxItems": 32
        }
      }
    },
    "equip_slot": {
      "type": "string",
      "enum": [
        "hands",
        "offhand",
        "head",
        "body",
        "trinket",
        "none"
      ]
    },
    "repair": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "cost_recipe_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        }
      }
    },
    "rarity": {
      "type": "string",
      "enum": [
        "common",
        "uncommon",
        "rare",
        "epic",
        "legendary"
      ]
    },
    "icon_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
    },
    "effects": {
      "type": "object",
      "description": "Consumable effects placeholder (MVP). Intentionally empty; forward-compatible.",
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "tool"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "subtype",
          "tier",
          "durability",
          "mining",
          "equip_slot"
        ],
        "properties": {
          "subtype": {
            "enum": [
              "pickaxe",
              "drill"
            ]
          },
          "stack_size": {
            "const": 1
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "material"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "subtype": {
            "enum": [
              "ore",
              "ingot",
              "gem",
              "misc"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "mining"
              ]
            },
            {
              "required": [
                "durability"
              ]
            },
            {
              "required": [
                "tool_effects"
              ]
            },
            {
              "required": [
                "equip_slot"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "consumable"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "properties": {
          "subtype": {
            "enum": [
              "potion",
              "misc"
            ]
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "mining"
              ]
            },
            {
              "required": [
                "tool_effects"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "quest"
          }
        },
        "required": [
          "kind"
        ]
      },
      "then": {
        "required": [
          "subtype"
        ],
        "properties": {
          "subtype": {
            "const": "misc"
          },
          "stack_size": {
            "const": 1
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "combat"
              ]
            },
            {
              "required": [
                "mining"
              ]
            },
            {
              "required": [
                "durability"
              ]
            },
            {
              "required": [
                "tool_effects"
              ]
            }
          ]
        }
      }
    }
  ],
  "examples": [
    {
      "version": 1,
      "id": "tool.pick.t0.starter",
      "kind": "tool",
      "name": "Starter Pick",
      "description": "A basic pickaxe for new miners.",
      "tags": [
        "tool",
        "pickaxe",
        "tier:0"
      ],
      "stack_size": 1,
      "rarity": "common",
      "icon_id": "icon.tools.pick.starter",
      "subtype": "pickaxe",
      "tier": 0,
      "durability": {
        "max": 100
      },
      "mining": {
        "power": 1,
        "speed": 1.2,
        "stamina_cost": 0
      },
      "equip_slot": "hands"
    },
    {
      "version": 1,
      "id": "mat.ore.copper",
      "kind": "material",
      "name": "Copper Ore",
      "description": "A chunk of raw copper-bearing rock.",
      "tags": [
        "material",
        "ore",
        "metal:copper"
      ],
      "stack_size": 99,
      "rarity": "common",
      "icon_id": "icon.material.ore.copper",
      "subtype": "ore"
    }
  ]
}