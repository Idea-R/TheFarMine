{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://thefarmine.dev/schemas/item-schema-v1.json",
  "title": "The Far Mine — Item Schema v1",
  "description": "Strict schema for item definitions consumed by the MVP data loader. Aligns with P4 contracts and current IDs. Validates base Item shape and subtypes: tool, material, component, consumable.",
  "type": "object",
  "properties": {
    "version": {
      "type": "integer",
      "const": 1,
      "description": "Data format version for item records. Must be 1 for this MVP."
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
      "description": "Stable item identifier. Lowercase dot-delimited path, segments may include underscore after the first. Example: tool.pick.t0.starter"
    },
    "kind": {
      "type": "string",
      "enum": ["tool", "material", "component", "consumable"],
      "description": "Discriminator for item subtype. MVP uses tool and material; component and consumable are allowed for forward compatibility."
    },
    "name": {
      "type": "string",
      "maxLength": 48,
      "description": "Display name (<= 48 chars)."
    },
    "description": {
      "type": "string",
      "maxLength": 160,
      "description": "Optional short description or flavor text (<= 160 chars)."
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true,
      "description": "Optional classification tags for UI/logic such as ore, metal, wood, craft_only, non_drop."
    },
    "stack_size": {
      "type": "integer",
      "minimum": 1,
      "description": "Stacking capacity. For tools must be exactly 1. For non-tools typically 20–99."
    },
    "icon_id": {
      "type": "string",
      "minLength": 1,
      "description": "Optional UI icon token id."
    },
    "rarity": {
      "type": "string",
      "enum": ["common", "uncommon", "rare", "epic"],
      "default": "common",
      "description": "Optional rarity tier. Defaults to common if omitted."
    },

    "subtype": {
      "type": "string",
      "enum": ["pickaxe", "drill", "hammer"],
      "description": "Tool subtype. MVP uses pickaxe."
    },
    "tier": {
      "type": "integer",
      "minimum": 0,
      "description": "Tool tier (>= 0). T0 starter, T1 copper, T2 reinforced, T3 steel (future)."
    },
    "durability": {
      "$ref": "#/$defs/Durability"
    },
    "mining": {
      "$ref": "#/$defs/Mining"
    },
    "combat": {
      "$ref": "#/$defs/Combat"
    },
    "tool_effects": {
      "type": "object",
      "properties": {
        "can_mine": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "List of ore/rock tags the tool can break (e.g., rock.t0, ore.copper, ore.iron.t1p) for UI gating."
        }
      },
      "required": ["can_mine"],
      "additionalProperties": false
    },
    "weight": {
      "type": "number",
      "minimum": 0,
      "description": "Optional mass for future encumbrance systems."
    },
    "equip_slot": {
      "type": "string",
      "const": "hands",
      "description": "Equip slot. MVP tools use hands."
    },
    "repair": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" },
        "costs": {
          "type": "array",
          "items": { "$ref": "#/$defs/QtyRef" },
          "minItems": 1,
          "description": "If repairs are enabled, the cost items required."
        }
      },
      "required": ["enabled"],
      "additionalProperties": false,
      "description": "Repair configuration. MVP may disable repairs."
    },

    "material_type": {
      "type": "string",
      "enum": ["ore", "ingot", "binding", "wood", "crystal", "scrap"],
      "description": "Material classification."
    },
    "value": {
      "type": "integer",
      "minimum": 0,
      "description": "Optional economy stub value in base units."
    },
    "drops_from": {
      "type": "array",
      "items": { "$ref": "#/$defs/IdRef" },
      "uniqueItems": true,
      "description": "Documentary references to node/enemy sources (e.g., node.ore.copper, enemy.goblin.grunt)."
    },

    "component_type": {
      "type": "string",
      "enum": ["binding", "haft", "mechanism", "lens"],
      "description": "Component classification."
    },

    "effect_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
      "description": "Consumable effect identifier (e.g., consumable.buff.stamina)."
    },
    "duration_sec": {
      "type": "number",
      "minimum": 0,
      "description": "Duration in seconds for time-based consumable effects."
    }
  },
  "required": ["version", "id", "kind", "name"],
  "additionalProperties": false,

  "allOf": [
    {
      "if": {
        "properties": { "kind": { "const": "tool" } },
        "required": ["kind"]
      },
      "then": {
        "properties": { "stack_size": { "const": 1 } },
        "required": ["stack_size"]
      }
    }
  ],

  "oneOf": [
    {
      "title": "Tool",
      "properties": {
        "kind": { "const": "tool" }
      },
      "required": ["subtype", "tier", "durability", "mining", "equip_slot", "stack_size"],
      "additionalProperties": true
    },
    {
      "title": "Material",
      "properties": {
        "kind": { "const": "material" }
      },
      "required": ["material_type", "stack_size"],
      "allOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["durability"] },
              { "required": ["mining"] },
              { "required": ["combat"] },
              { "required": ["equip_slot"] }
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    {
      "title": "Component",
      "properties": {
        "kind": { "const": "component" }
      },
      "required": ["component_type", "stack_size"],
      "allOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["durability"] },
              { "required": ["mining"] }
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    {
      "title": "Consumable",
      "properties": {
        "kind": { "const": "consumable" }
      },
      "required": ["effect_id", "duration_sec", "stack_size"],
      "allOf": [
        {
          "not": {
            "anyOf": [
              { "required": ["durability"] },
              { "required": ["mining"] }
            ]
          }
        }
      ],
      "additionalProperties": true
    }
  ],

  "$defs": {
    "IdRef": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
      "description": "Identifier reference. Lowercase dot path with underscores allowed after the first segment."
    },
    "QtyRef": {
      "type": "object",
      "properties": {
        "id": { "$ref": "#/$defs/IdRef" },
        "qty": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": ["id", "qty"],
      "additionalProperties": false,
      "description": "Reference to an item and a positive quantity."
    },
    "Durability": {
      "type": "object",
      "properties": {
        "max": {
          "type": "integer",
          "minimum": 1,
          "description": "Maximum durability as stored in data."
        },
        "current": {
          "type": "integer",
          "minimum": 0,
          "description": "Runtime field; when present must be <= max (enforced at runtime)."
        }
      },
      "required": ["max"],
      "additionalProperties": false,
      "description": "Durability stats for tools."
    },
    "Mining": {
      "type": "object",
      "properties": {
        "power": {
          "type": "number",
          "minimum": 0,
          "description": "Mining power. Compared to TileData.hardness; power >= hardness allows progress. Sub-threshold may increase durability loss in future rules. Mapped to MineHitEvent.power."
        },
        "speed": {
          "type": "number",
          "minimum": 0,
          "description": "Swing rate in swings/sec (hits/sec). UI may derive time-per-tile ~= hardness/power adjusted."
        },
        "stamina_cost": {
          "type": "number",
          "minimum": 0,
          "description": "Stamina consumed per swing; aligns with Gamma defaults where applicable."
        }
      },
      "required": ["power", "speed", "stamina_cost"],
      "additionalProperties": false,
      "description": "Mining performance characteristics. ECS mapping: MineHitEvent.power sourced from mining.power."
    },
    "Combat": {
      "type": "object",
      "properties": {
        "damage_base": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Base damage if used as a weapon."
        },
        "poise_damage": {
          "type": "integer",
          "minimum": 0,
          "default": 0,
          "description": "Poise/stagger damage if used as a weapon."
        }
      },
      "required": ["damage_base", "poise_damage"],
      "additionalProperties": false,
      "description": "Optional combat stats for tools doubling as weapons."
    }
  },

  "examples": [
    {
      "version": 1,
      "id": "tool.pick.t0.starter",
      "kind": "tool",
      "name": "Starter Pickaxe",
      "description": "A basic pick for soft stone.",
      "tags": ["tool", "pickaxe", "starter"],
      "stack_size": 1,
      "rarity": "common",
      "subtype": "pickaxe",
      "tier": 0,
      "durability": { "max": 50 },
      "mining": { "power": 1.0, "speed": 1.2, "stamina_cost": 5 },
      "equip_slot": "hands",
      "tool_effects": { "can_mine": ["rock.t0", "ore.copper"] }
    },
    {
      "version": 1,
      "id": "mat.ore.copper",
      "kind": "material",
      "name": "Copper Ore",
      "tags": ["ore", "metal"],
      "material_type": "ore",
      "stack_size": 99,
      "value": 3,
      "drops_from": ["node.ore.copper"]
    },
    {
      "version": 1,
      "id": "mat.binding.copper",
      "kind": "component",
      "name": "Copper Binding",
      "component_type": "binding",
      "stack_size": 50,
      "value": 2
    }
  ]
}