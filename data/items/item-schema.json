        "enum": [],
        "notes": []
      }
    ]
  },
  "validation_rules": {
    "id_rules": [
      "lowercase",
      "dot-delimited",
      "stable across versions"
    ],
    "tool_invariants": [
      "tools must have stack_size=1",
      "tool.mining_power gates tile.hardness: must be ≥ hardness to damage tile",
      "stamina_per_swing integrates with stamina component; if player stamina < cost, mining fails",
      "durability_max ≥ 1; runtime decrements per swing; on 0, disable mining actions"
    ],
    "material_invariants": [
      "material_type 'ore' must carry tag 'ore'",
      "rarity informs drop weights but is non-functional in MVP"
    ],
    "cross_refs": [
      "data/core/component-schemas.json: tile.hardness bands",
      "data/crafting/recipes.json: inputs/outputs must reference valid item ids",
      "docs/technology-systems/crafting-design.md: tuning notes"
    ],
    "numeric_clamps": {
      "mining_power": {
        "min": 0,
        "max": 20
      },
      "mining_speed": {
        "min": 0.1,
        "max": 10.0
      },
      "stamina_per_swing": {
        "min": 0,
        "max": 100
      },
      "durability_max": {
        "min": 1,
        "max": 9999
      },
      "stack_size": {
        "min": 1,
        "max": 999
      }
    }
  },
