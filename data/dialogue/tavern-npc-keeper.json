    "notes": "Tavern Keeper lines for the Hearth & Anvil; Three-Wide safety; lore seeds and gentle guidance."
  },
  "npc": {
    "id": "npc.tavern.keeper",
    "name": "The Keeper",
    "place_id": "lore.place.tavern.hearth_and_anvil",
    "ambience_id": "amb.tavern.loopA"
  },
  "config": {
    "ui_safe": true,
    "max_line_chars": 110,
    "show_nameplate": true,
    "voice": "dwarven_steadfast",
    "default_mood": "mood.stillshift"
  },
  "lines": [
    {
      "id": "dlg.keeper.welcome.v1",
      "text": "Welcome to the Hearth & Anvil. Keep to the Three-Wide Law, and you'll leave with all toes.",
      "tags": [
        "welcome",
        "safety",
        "l1"
      ],
      "requires": {
        "first_visit": true
      },
      "grants": {
        "seen_flag": "seen.keeper.intro"
      },
      "audio": {
        "triggerKey": "ui.confirm",
        "volume_db": -3
      },
      "hooks": [
        "lore.term.three_wide"
      ],
      "cooldown_sec": 120
    },
    {
      "id": "dlg.keeper.tut.tools.t0.v1",
      "text": "Starter Pickaxe bites soft rock. Test faces first; don't chase sparks until you've learned the grain.",
      "tags": [
        "tutorial",
        "tools",
        "t0",
        "l1"
      ],
      "requires": {
        "has_tool_tier_min": 0
      },
      "audio": {
        "triggerKey": "ui.confirm",
        "volume_db": -4
      },
      "hooks": [
        "tool.pick.t0.starter"
      ],
      "cooldown_sec": 45
    },
    {
      "id": "dlg.keeper.tut.ore.copper.v1",
      "text": "Copper likes the edges—veins cling to main paths and wall shadows. Keep eyes and toes.",
      "tags": [
        "hint",
        "ore",
        "copper",
        "l1"
      ],
      "hooks": [
        "ore.copper"
      ],
      "cooldown_sec": 30
    },
    {
      "id": "dlg.keeper.rule.three_wide.v1",
      "text": "Three wide keeps breath inside; one stumble, two shoulders, no tunnel turns to coffin.",
      "tags": [
        "rule",
        "proverb",
        "safety",
        "l1"
      ],
      "hooks": [
        "lore.term.three_wide"
      ],
      "cooldown_sec": 60
    },
    {
      "id": "dlg.keeper.myth.deepsong.v1",
      "text": "Hear that hum in your bones? The Deepsong keeps time when clocks forget.",
      "tags": [
        "myth",
        "deepsong",
        "l2"
      ],
      "hooks": [
        "lore.term.deepsong"
      ],
      "cooldown_sec": 50
    },
    {
      "id": "dlg.keeper.gossip.guilds.v1",
      "text": "Mind the guild lot: Borewrights brag, Riveters bark, Stonebinders tally. Tip well; tempers cool.",
      "tags": [
        "gossip",
        "guilds",
        "l2"
      ],
      "hooks": [
        "guild.borewrights",
        "guild.riveters",
        "guild.stonebinders"
      ],
      "cooldown_sec": 40
    },
    {
      "id": "dlg.keeper.quip.lampwatch.v1",
      "text": "On Lampwatch, count your breaths between swings; steady hands see dawn that eyes don't.",
      "tags": [
        "quip",
        "night",
        "l3"
      ],
      "mood": "mood.lampwatch",
      "hooks": [
        "lore.term.lampwatch"
      ],
      "cooldown_sec": 45
    },
    {
      "id": "dlg.keeper.tip.stamina.v1",
      "text": "Don't race the stone. Breathe, plant your stance, and let the rhythm carry your work.",
      "tags": [
        "tip",
        "stamina",
        "l2"
      ],
      "hooks": [
        "component.stamina"
      ],
      "cooldown_sec": 25
    },
    {
      "id": "dlg.keeper.legend.orecasters.v1",
      "text": "Old tales speak of Orecasters—runic engines that sang ore from stone. Best left as tales.",
      "tags": [
        "legend",
        "ancient",
        "l3"
      ],
      "hooks": [
        "lore.civ.orecasters"
      ],
      "cooldown_sec": 60
    },
    {
      "id": "dlg.keeper.farewell.gearbless.v1",
      "text": "Gearbless on your path. Leave a chair warm for stories when you circle back.",
      "tags": [
        "farewell",
        "blessing",
        "l1"
      ],
      "mood": "mood.gearbless",
      "audio": {
        "triggerKey": "ui.confirm",
        "volume_db": -3
      },
      "hooks": [
        "lore.term.gearbless"
      ],
      "cooldown_sec": 35
    }
  ],
  "acceptance": {
    "notes": [
      "All lines ≤110 chars; no mechanical guarantees; mood gates optional.",
      "audio.triggerKey keys align to sound-manifest.json (e.g., ui.confirm).",
      "hooks reference stable lore/tool ids (e.g., lore.term.three_wide)."
