{
  "version": 1,
  "id": "npc.tavern.keeper",
  "name": "Tavern Keeper",
  "meta": {
    "ambienceBedId": "amb.tavern.loopA",
    "locationToken": "lore.place.tavern.hearth_and_anvil",
    "notes": ["Diegetic tutorial anchor; no promises", "MVP static scene; UI-safe copy"]
  },
  "lines": [
    {
      "id": "line.keeper.welcome",
      "text": "Hearth & Anvil welcomes you, delver—wipe your boots, wet your throat, and mind the bell.",
      "tags": ["welcome"],
      "conditions": { "once": true, "requireFlags": [], "excludeFlags": [] },
      "sfx": null,
      "uiHint": null
    },
    {
      "id": "line.keeper.sell_ore_tip",
      "text": "Pack rattling with ore? Slide it across the counter and I'll weigh it fair, coin for clink.",
      "tags": ["tutorial", "craft"],
      "conditions": { "once": false, "requireFlags": [], "excludeFlags": [] },
      "sfx": null,
      "uiHint": null
    },
    {
      "id": "line.keeper.smelt_copper",
      "text": "Copper likes a hot hello; feed your chunks to the smelter before dreaming up fittings.",
      "tags": ["tutorial", "craft"],
      "conditions": { "once": false, "requireFlags": [], "excludeFlags": [] },
      "sfx": null,
      "uiHint": null
    },
    {
      "id": "line.keeper.reinforced_pick_hook",
      "text": "Set your sights on a Reinforced Pick—first good friend in the dark. Build steady, not flashy.",
      "tags": ["progression", "craft"],
      "conditions": { "once": false, "requireFlags": [], "excludeFlags": [] },
      "sfx": null,
      "uiHint": null
    },
    {
      "id": "line.keeper.three_wide_law",
      "text": "Three-Wide, always: carve a lane a dwarf and his two shadows can share. Stone spares the careful.",
      "tags": ["safety"],
      "conditions": { "once": false, "requireFlags": [], "excludeFlags": [] },
      "sfx": null,
      "uiHint": null
    },
    {
      "id": "line.keeper.mine_mood_today",
      "text": "Mine's in Stillshift today—the drips keep even time. Work with the rhythm, take what it gives.",
      "tags": ["mine_mood", "lore"],
      "conditions": { "once": false, "requireFlags": [], "excludeFlags": [] },
      "sfx": null,
      "uiHint": null
    },
    {
      "id": "line.keeper.guild_murmur",
      "text": "Guild banners drink here; keep your ears open. Favors flow like ale, and settle slower.",
      "tags": ["guilds", "lore"],
      "conditions": { "once": false, "requireFlags": [], "excludeFlags": [] },
      "sfx": null,
      "uiHint": null
    },
    {
      "id": "line.keeper.crystal_caverns_blurb",
      "text": "Past the rattlecut, the Crystal Caverns hum. Quartz keeps a shy song; listen with your teeth.",
      "tags": ["lore"],
      "conditions": { "once": false, "requireFlags": [], "excludeFlags": [] },
      "sfx": null,
      "uiHint": null
    },
    {
      "id": "line.keeper.lamps_and_spans",
      "text": "Hang a lamp at measured spans—count your strides like a mason. Light remembers the way back.",
      "tags": ["safety", "tutorial"],
      "conditions": { "once": false, "requireFlags": [], "excludeFlags": [] },
      "sfx": null,
      "uiHint": null
    },
    {
      "id": "line.keeper.farewell",
      "text": "Off you go, delver. Stone watch your steps, and this door stays warm for your return.",
      "tags": ["farewell"],
      "conditions": { "once": false, "requireFlags": [], "excludeFlags": [] },
      "sfx": null,
      "uiHint": null
    }
  ]
}