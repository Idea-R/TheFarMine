    },
    {
      "id": "dlg.tavern.keeper.007",
      "text": "guild.hammerwrights say 'Measure twice, strike thrice'; guild.smokestack grin through the soot.",
      "tags": ["faction", "rumor"],
      "priority": 0
    },
    {
