    "material.iron.base": "#7a7f86",
    "material.iron.shadow": "#3a3e44",

    "material.leather.base": "#6a4a2e",
    "material.wood.base": "#7b5a36",

    "terrain.rock.light": "#9aa0a6",
    "terrain.rock.base": "#6b7077",
    "terrain.rock.deep": "#4a4f55",
    "terrain.rock.shadow": "#2c3035",
    "terrain.soil.base": "#5a4330",
    "terrain.wall_mortar.base": "#8a806e",

    "ore.copper": "#c8733d",
    "ore.iron": "#8a8f99",
    "crystal.quartz": "#7fd1f5",

    "telegraph.arc.amber": "#ffb33a",
    "telegraph.arc.cyan": "#2fd4ff",
    "fx.hitflash": "#fffaf2",
    "fx.damage": "#ff4a3d",
    "fx.heal": "#3bd17a",
    "fx.ui_focus": "#e0b04a",

    "light.lamp.glow": "#ffcf6a",
    "light.torch.glow": "#ffb14a",
    "light.crystal.glow": "#6fd3ff",
    "light.ambient.near": "#2a2218",
    "light.ambient.mid": "#1f1a14",
    "light.ambient.deep": "#15110d",
    "shadow.ambient": "#0e0c0a",

    "minimap.floor": "#4a3a2a",
    "minimap.wall": "#3a3128",
    "minimap.ore.copper": "#d87a3c",
    "minimap.ore.iron": "#8a929d",
    "minimap.crystal.quartz": "#7fd1ff",
    "minimap.anchor.lamp": "#ffcf6a",
    "minimap.rubble": "#6b5a48",
    "minimap.marker.spawn": "#4be073",
    "minimap.marker.exit": "#ff5a76",
    "minimap.void": "#000000",
    "minimap.solid_rock": "#2a2a2a",
    "minimap.floor_alt": "#55412f",
    "minimap.wall_alt": "#2f2720",

    "tint.guild.hammerwrights": "#c9a85a",
    "tint.guild.glassvein": "#6fd3ff",
    "tint.guild.smokestack": "#7a7f86"
  },
  "accessibility": {
    "contrast_pairs": [
      { "fg": "ui.text.primary", "bg": "ui.panel.bg", "target_ratio": 4.5 },
      { "fg": "ui.text.secondary", "bg": "ui.panel.bg", "target_ratio": 3.0 },
      { "fg": "ui.bar.health.fg", "bg": "ui.panel.bg", "target_ratio": 3.0 },
      { "fg": "ui.bar.stamina.fg", "bg": "ui.panel.bg", "target_ratio": 3.0 },
      { "fg": "telegraph.arc.amber", "bg": "shadow.ambient", "target_ratio": 3.0 }
    ]
  },
  "mapping": {
    "telegraph_colors": {
      "melee_default": "telegraph.arc.amber",
      "ranged_default": "telegraph.arc.cyan"
    },
    "tile_codes": {
      "0": "minimap.void",
      "1": "minimap.solid_rock",
      "2": "minimap.floor",
      "3": "minimap.wall",
      "10": "minimap.ore.copper",
      "11": "minimap.crystal.quartz",
      "12": "minimap.ore.iron",
      "20": "minimap.anchor.lamp",
      "21": "minimap.rubble",
      "30": "minimap.marker.spawn",
      "31": "minimap.marker.exit"
    }
  }
}