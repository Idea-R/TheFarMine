{
  "version": 1,
  "meta": {
    "author": "eta",
    "date": "2026-02-18",
    "notes": "Core palette v1 with warm brass/copper UI bias and cool crystal accents. Telegraphs tuned to pop over ambient shadow."
  },
  "palette": {
    "ui.panel.bg": "#221a12",
    "ui.panel.border": "#6f5723",
    "ui.panel.accent": "#b48d3a",
    "ui.text.primary": "#eadfb7",
    "ui.text.secondary": "#c2ad74",
    "ui.text.inverted": "#2b2014",
    "ui.icon.default": "#c9a85a",
    "ui.icon.active": "#ffd071",
    "ui.bar.health.bg": "#4a1e1a",
    "ui.bar.health.fg": "#e24a3b",
    "ui.bar.stamina.bg": "#1e3a2c",
    "ui.bar.stamina.fg": "#2fc377",
    "ui.hotbar.slot.bg": "#1a140e",
    "ui.hotbar.slot.border": "#5a4620",
    "ui.hotbar.selection": "#e0b04a",
    "ui.tooltip.bg": "#0f0c09",
    "ui.tooltip.border": "#8a6b2c",
    "ui.tooltip.text": "#f2e9cf",
    "ui.cursor": "#7fd1ff",
    "ui.warning": "#ff9c3a",
    "ui.success": "#36c27a",
    "ui.info": "#5ab3ff",

    "material.brass.light": "#d5b35a",
