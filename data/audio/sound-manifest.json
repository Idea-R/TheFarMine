{
  "_schema_hint": {
    "notes": "Lite schema hint for audio runtime. This is NOT a formal JSON Schema but aims to be precise. All sound entries are strict (additionalProperties:false), using only the documented fields below. Ids are stable; file paths are snake_case and relative within project.",
    "manifest": {
      "version": "int (schema version; current=1)",
      "meta": {
        "author": "string",
        "date": "ISO-8601 date (YYYY-MM-DD)",
        "notes": "string"
      },
      "buses": "array<bus_def> where bus_def={ id:string, kind?:\"master\", parent?:string, gain_db:number }",
      "duckSends": "array<duck_def> where duck_def={ id:string, target_bus:string, amount_db:number, attack_ms:int, hold_ms:int, release_ms:int }",
      "defaults": "{ spatial:bool, radius:number, falloff:\"linear\"|\"inverse\"|\"log\", max_poly_global:int, pitch_rand:number(semitones), vol_rand_db:number(dB) }",
      "categories": "array<category_def> where category_def={ id:string, bus:string, priority_floor:int, priority_ceil:int }",
      "sounds": "array<sound_def>"
    },
    "sound_def": {
      "requiredKeys": [
        "id",
        "category",
        "bus",
        "file",
        "loop",
        "volume_db",
        "priority",
        "max_poly",
        "preload",
        "spatial",
        "radius",
        "pitch_rand",
        "vol_rand_db",
        "triggerKey",
        "tags"
      ],
      "optionalKeys": [
        "var_group",
        "duck",
        "envelopes"
      ],
      "shape": {
        "id": "string (stable asset id; e.g., sfx.mine.hit.rock.v1)",
        "category": "enum [\"sfx\",\"ui\",\"amb\",\"music\"]",
        "bus": "string bus id (e.g., bus.sfx, bus.amb, bus.music, bus.ui)",
        "file": "string path, e.g., assets/audio/sfx/mining/mine_hit_rock_v1.wav",
        "loop": "bool (true only for ambience/music beds)",
        "volume_db": "number (asset trim; 0 default)",
        "priority": "int [10..100] (voice arbitration weight)",
        "max_poly": "int (per-id voice cap)",
        "preload": "bool (hotset in memory at boot)",
        "spatial": "bool",
        "radius": "number (world units; ignored when spatial=false)",
        "pitch_rand": "number (± semitones per play)",
        "vol_rand_db": "number (± dB per play)",
        "var_group": "string (variation group id; round-robin/WRR)",
        "triggerKey": "string (AudioEventBridge route key)",
        "tags": "array<string> (search/filter facets)",
        "duck": "array<string> (duckSend ids applied on play)",
        "envelopes": "{ fade_in_ms:int, fade_out_ms:int } (loops/long tails)"
      },
      "additionalProperties": false
    }
  },
  "version": 1,
