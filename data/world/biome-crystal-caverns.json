{
  "version": 1,
  "id": "biome.crystal.caverns",
  "name": "Crystal Caverns",
  "mapDefaults": {
    "width": 96,
    "height": 64
  },
  "tiles": {
    "floor": {
      "tileType": "floor",
      "hardness": 1
    },
    "rock": {
      "tileType": "rock",
      "hardness": 3
    },
    "ore": {
      "tileType": "rock.ore",
      "baseHardness": 4,
      "oreTypes": [
        { "id": "ore.copper", "weight": 0.64 },
        { "id": "ore.iron", "weight": 0.3 },
        { "id": "shard.quartz", "weight": 0.06 }
      ]
    }
  },
  "lighting": {
    "ambientTintToken": "mapping.depthTint.l0",
    "lamps": {
      "atDoors": true,
      "intervalTiles": 12,
      "tintToken": "mapping.lighting.lampWarm"
    },
    "crystalTintToken": "mapping.lighting.crystalCool"
  },
  "oreSeeding": {
    "edgeBias": 0.7,
    "noise": {
      "octaves": 2,
      "scale": 0.12,
      "threshold": 0.58
    },
    "cluster": {
      "min": 2,
      "max": 6
    },
    "laneClearanceTiles": 1
  },
  "decoration": {
    "crystalOnAlcove": true,
    "maxCrystals": 28,
    "cluster": {
      "min": 1,
      "max": 3,
      "minSeparation": 2
    },
    "props": [
      { "kind": "crystal", "tintToken": "mapping.lighting.crystalCool" }
    ]
  },
  "spawnRules": {
    "enemyWeights": {
      "enemy.goblin.grunt": 0.6,
      "enemy.cave.burrower": 0.4
    },
    "minSeparationTiles": 8,
    "preferCorridors": true,
    "doorExclusionRadius": 6
  },
  "minimap": {
    "tokens": {
      "room": "minimap.room",
      "corridor": "minimap.corridor",
      "player": "minimap.player",
      "enemy": "minimap.enemy",
      "ore": "minimap.ore",
      "bg": "minimap.bg"
    }
  },
  "notes": [
    "Quartz is rare here. It can appear as rock.ore with very low weight; per Crafting §6, its effective hardness should gate to T3 (Steam Drill). For MVP, engines may treat shard.quartz ore tiles with hardness=baseHardness+2 (implementation detail in Mining/Worldgen); alternatively keep weight low and rely on loot/decor.",
    "Corridors observe the Three-wide Law. Lamps spawn at doors and ~every 12 tiles to keep lanes lit.",
    "Hardness contract: floor 0–1, rock 3, copper seam ~4, iron seam ~5, quartz seam ~6–7 (if present)."
  ]
}