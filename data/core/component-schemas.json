{
  "version": 1,
  "components": [
    {
      "name": "Position",
      "bit": 0,
      "defaults": { "x": 0, "y": 0, "layer": 0 },
      "fields": [
        { "key": "x", "type": "number", "min": null, "max": null, "notes": "world x (px); unbounded float" },
        { "key": "y", "type": "number", "min": null, "max": null, "notes": "world y (px); unbounded float" },
        { "key": "layer", "type": "int", "min": 0, "max": 7, "notes": "render/physics layer 0..7" }
      ]
    },
    {
      "name": "Velocity",
      "bit": 1,
      "defaults": { "vx": 0, "vy": 0 },
      "fields": [
        { "key": "vx", "type": "number", "min": null, "max": null, "notes": "velocity x (px/s); unbounded float" },
        { "key": "vy", "type": "number", "min": null, "max": null, "notes": "velocity y (px/s); unbounded float" }
      ]
    },
    {
      "name": "Attributes",
      "bit": 2,
      "defaults": { "attackPower": 0, "defense": 0 },
      "fields": [
        { "key": "attackPower", "type": "int", "min": 0, "max": 999, "notes": "clamped integer [0..999]" },
        { "key": "defense", "type": "int", "min": 0, "max": 999, "notes": "clamped integer [0..999]" }
      ]
    },
    {
      "name": "Health",
      "bit": 3,
      "defaults": { "max": 100, "value": 100 },
      "fields": [
        { "key": "max", "type": "int", "min": 1, "max": 10000, "notes": "max health [1..10000]" },
        { "key": "value", "type": "int", "min": 0, "max": null, "notes": "dynamic clamp to [0..max] at add/patch" }
      ]
    },
    {
      "name": "Stamina",
      "bit": 4,
      "defaults": { "max": 100, "value": 100, "regenPerSec": 14, "regenDelayAfterActionMs": 600 },
      "fields": [
        { "key": "max", "type": "int", "min": 1, "max": 10000, "notes": "max stamina [1..10000]" },
        { "key": "value", "type": "int", "min": 0, "max": null, "notes": "dynamic clamp to [0..max] at add/patch" },
        { "key": "regenPerSec", "type": "number", "min": 0, "max": 1000, "notes": "recovery rate per second [0..1000]" },
        { "key": "regenDelayAfterActionMs", "type": "int", "min": 0, "max": 60000, "notes": "delay after action before regen [0..60000] ms" }
      ]
    },
    {
      "name": "Poise",
      "bit": 5,
      "defaults": { "max": 100, "value": 100, "recoverPerSec": 35, "breakDurationMs": 800 },
      "fields": [
        { "key": "max", "type": "int", "min": 1, "max": 10000, "notes": "max poise [1..10000]" },
        { "key": "value", "type": "int", "min": 0, "max": null, "notes": "dynamic clamp to [0..max] at add/patch" },
        { "key": "recoverPerSec", "type": "number", "min": 0, "max": 1000, "notes": "recovery rate per second [0..1000]" },
        { "key": "breakDurationMs", "type": "int", "min": 0, "max": 60000, "notes": "poise-broken duration [0..60000] ms" }
      ]
    },
    {
      "name": "Inventory",
      "bit": 6,
      "defaults": { "capacity": 20, "slots": {} },
      "fields": [
        { "key": "capacity", "type": "int", "min": 1, "max": 999, "notes": "slot capacity [1..999]" },
        { "key": "slots", "type": "object", "min": null, "max": null, "notes": "shallow map itemId:string -> qty:int; primitive leaves only" }
      ]
    },
    {
      "name": "Renderable",
      "bit": 7,
      "defaults": { "visible": true, "depth": 0, "scale": 1, "tintToken": "" },
      "fields": [
        { "key": "visible", "type": "bool", "min": null, "max": null, "notes": "coerced via !!value" },
        { "key": "depth", "type": "int", "min": -32768, "max": 32767, "notes": "render depth [-32768..32767]" },
        { "key": "scale", "type": "number", "min": 0.1, "max": 16, "notes": "sprite scale [0.1..16]" },
        { "key": "tintToken", "type": "string", "min": null, "max": null, "notes": "arbitrary token; String(value)" }
      ]
    },
    {
      "name": "Collider",
      "bit": 8,
      "defaults": { "w": 12, "h": 12, "offsetX": 0, "offsetY": 0, "solid": false, "isTrigger": false, "hurtboxPadPx": 0 },
      "fields": [
        { "key": "w", "type": "int", "min": 0, "max": 1024, "notes": "width px [0..1024]" },
        { "key": "h", "type": "int", "min": 0, "max": 1024, "notes": "height px [0..1024]" },
        { "key": "offsetX", "type": "int", "min": -1024, "max": 1024, "notes": "offset x px [-1024..1024]" },
        { "key": "offsetY", "type": "int", "min": -1024, "max": 1024, "notes": "offset y px [-1024..1024]" },
        { "key": "solid", "type": "bool", "min": null, "max": null, "notes": "coerced via !!value" },
        { "key": "isTrigger", "type": "bool", "min": null, "max": null, "notes": "coerced via !!value" },
        { "key": "hurtboxPadPx", "type": "int", "min": 0, "max": 16, "notes": "expand hurtbox by px [0..16]" }
      ]
    },
    {
      "name": "AI",
      "bit": 9,
      "defaults": { "behavior": "idle", "state": "idle", "targetId": 0, "attackCooldownMs": 0, "preferOpenLane": true },
      "fields": [
        { "key": "behavior", "type": "string", "min": null, "max": null, "notes": "behavior tree/state id; String(value)" },
        { "key": "state", "type": "string", "min": null, "max": null, "notes": "runtime substate; String(value)" },
        { "key": "targetId", "type": "int", "min": 0, "max": 16777215, "notes": "entity id [0..16777215]" },
        { "key": "attackCooldownMs", "type": "int", "min": 0, "max": 60000, "notes": "cooldown ms [0..60000]" },
        { "key": "preferOpenLane", "type": "bool", "min": null, "max": null, "notes": "coerced via !!value" }
      ]
    },
    {
      "name": "Player",
      "bit": 10,
      "defaults": { "inputEnabled": true },
      "fields": [
        { "key": "inputEnabled", "type": "bool", "min": null, "max": null, "notes": "coerced via !!value" }
      ]
    },
    {
      "name": "Enemy",
      "bit": 11,
      "defaults": { "kind": "" },
      "fields": [
        { "key": "kind", "type": "string", "min": null, "max": null, "notes": "enemy kind token; String(value)" }
      ]
    },
    {
      "name": "Item",
      "bit": 12,
      "defaults": { "itemId": "", "qty": 1, "stackable": true, "onGround": true },
      "fields": [
        { "key": "itemId", "type": "string", "min": null, "max": null, "notes": "item id; String(value)" },
        { "key": "qty", "type": "int", "min": 0, "max": 9999, "notes": "stack count [0..9999]" },
        { "key": "stackable", "type": "bool", "min": null, "max": null, "notes": "coerced via !!value" },
        { "key": "onGround", "type": "bool", "min": null, "max": null, "notes": "coerced via !!value" }
      ]
    },
    {
      "name": "Tile",
      "bit": 13,
      "defaults": { "tileType": "rock", "hardness": 3, "breakable": true, "oreType": "" },
      "fields": [
        { "key": "tileType", "type": "string", "min": null, "max": null, "notes": "engine enforces allowed set; schema permissive" },
        { "key": "hardness", "type": "int", "min": 0, "max": 99, "notes": "break hardness [0..99]" },
        { "key": "breakable", "type": "bool", "min": null, "max": null, "notes": "coerced via !!value" },
        { "key": "oreType", "type": "string", "min": null, "max": null, "notes": "empty for non-ore; ids resolved in worldgen/mining" }
      ]
    },
    {
      "name": "Projectile",
      "bit": 14,
      "defaults": { "speedPxPerSec": 120, "ttlMs": 1500, "damage": { "base": 4, "poiseDamage": 10 } },
      "fields": [
        { "key": "speedPxPerSec", "type": "number", "min": 0, "max": 10000, "notes": "speed in px/s [0..10000]" },
        { "key": "ttlMs", "type": "int", "min": 1, "max": 60000, "notes": "time-to-live ms [1..60000]" },
        { "key": "damage", "type": "object", "min": null, "max": null, "notes": "shallow: { base:int [0..9999], poiseDamage:int [0..9999] }" }
      ]
    }
  ]
}