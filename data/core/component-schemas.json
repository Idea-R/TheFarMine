{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://the-far-mine/schema/component-schemas.json",
  "version": 1,
  "$defs": {
    "int": { "type": "integer" },
    "nonNegInt": { "type": "integer", "minimum": 0 },
    "posInt": { "type": "integer", "minimum": 1 },
    "finiteNum": { "type": "number" },
    "dirDeg": { "type": "integer", "minimum": 0, "maximum": 359 },
    "tileType": { "enum": ["rock", "floor", "ore.copper", "ore.iron", "ore.quartz"] },
    "tileHardness": { "enum": [3, 4, 5, 7] },
    "colliderKind": { "enum": ["actor", "tile", "attack"] },
    "aiState": { "type": "string" },
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "itemStack": {
      "type": "object",
      "additionalProperties": false,
      "required": ["itemId", "qty"],
      "properties": {
        "itemId": { "$ref": "#/$defs/nonEmptyString" },
        "qty": { "$ref": "#/$defs/nonNegInt" },
        "durability": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "hitboxRect": {
      "type": "object",
      "required": ["w", "h", "offsetX", "offsetY"],
      "additionalProperties": false,
      "properties": {
        "w": { "$ref": "#/$defs/nonNegInt" },
        "h": { "$ref": "#/$defs/nonNegInt" },
        "offsetX": { "$ref": "#/$defs/int" },
        "offsetY": { "$ref": "#/$defs/int" }
      }
    }
  },
  "components": {
    "Position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "dirDeg"],
      "properties": {
        "x": { "$ref": "#/$defs/int" },
        "y": { "$ref": "#/$defs/int" },
        "dirDeg": { "$ref": "#/$defs/dirDeg" }
      }
    },
    "Velocity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["vx", "vy", "maxSpeed"],
      "properties": {
        "vx": { "$ref": "#/$defs/finiteNum" },
        "vy": { "$ref": "#/$defs/finiteNum" },
        "maxSpeed": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "Health": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "value"],
      "properties": {
        "max": { "$ref": "#/$defs/posInt" },
        "value": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "Stamina": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "value", "regenPerSec", "regenDelayAfterActionMs", "regenCooldownUntilMs"],
      "properties": {
        "max": { "$ref": "#/$defs/nonNegInt" },
        "value": { "$ref": "#/$defs/nonNegInt" },
        "regenPerSec": { "$ref": "#/$defs/finiteNum" },
        "regenDelayAfterActionMs": { "$ref": "#/$defs/nonNegInt" },
        "regenCooldownUntilMs": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "Poise": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max", "value", "recoverPerSec", "breakDurationMs", "brokenUntilMs"],
      "properties": {
        "max": { "$ref": "#/$defs/nonNegInt" },
        "value": { "$ref": "#/$defs/nonNegInt" },
        "recoverPerSec": { "$ref": "#/$defs/finiteNum" },
        "breakDurationMs": { "$ref": "#/$defs/nonNegInt" },
        "brokenUntilMs": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "Attributes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attackPower", "defense"],
      "properties": {
        "attackPower": { "$ref": "#/$defs/nonNegInt" },
        "defense": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "Inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slots", "selectedIndex"],
      "properties": {
        "slots": {
          "type": "array",
          "items": { "$ref": "#/$defs/itemStack" }
        },
        "selectedIndex": { "type": "integer", "minimum": -1 }
      }
    },
    "Renderable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spriteId", "tintToken", "depth"],
      "properties": {
        "spriteId": { "$ref": "#/$defs/nonEmptyString" },
        "tintToken": { "$ref": "#/$defs/nonEmptyString" },
        "depth": { "$ref": "#/$defs/int" }
      }
    },
    "Collider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["w", "h", "offsetX", "offsetY", "kind", "solid", "mask"],
      "properties": {
        "w": { "$ref": "#/$defs/nonNegInt" },
        "h": { "$ref": "#/$defs/nonNegInt" },
        "offsetX": { "$ref": "#/$defs/int" },
        "offsetY": { "$ref": "#/$defs/int" },
        "kind": { "$ref": "#/$defs/colliderKind" },
        "solid": { "type": "boolean" },
        "mask": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "AI": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "targetId", "aggroRangePx", "leashRangePx", "cooldownUntilMs"],
      "properties": {
        "state": { "$ref": "#/$defs/aiState" },
        "targetId": {
          "anyOf": [
            { "$ref": "#/$defs/nonNegInt" },
            { "type": "null" }
          ]
        },
        "aggroRangePx": { "$ref": "#/$defs/nonNegInt" },
        "leashRangePx": { "$ref": "#/$defs/nonNegInt" },
        "cooldownUntilMs": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "PlayerTag": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {}
    },
    "EnemyTag": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kindId"],
      "properties": {
        "kindId": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "Tile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tileType", "hardness", "flags"],
      "properties": {
        "tileType": { "$ref": "#/$defs/tileType" },
        "hardness": { "$ref": "#/$defs/tileHardness" },
        "flags": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "AttackIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attackId", "requestedAtMs"],
      "properties": {
        "attackId": {
          "anyOf": [
            { "$ref": "#/$defs/nonEmptyString" },
            { "type": "null" }
          ]
        },
        "requestedAtMs": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "Hitbox": {
      "type": "object",
      "additionalProperties": false,
      "required": ["active", "w", "h", "offsetX", "offsetY", "ownerId"],
      "properties": {
        "active": { "type": "boolean" },
        "w": { "$ref": "#/$defs/nonNegInt" },
        "h": { "$ref": "#/$defs/nonNegInt" },
        "offsetX": { "$ref": "#/$defs/int" },
        "offsetY": { "$ref": "#/$defs/int" },
        "ownerId": { "$ref": "#/$defs/nonNegInt" }
      }
    },
    "AudioEmitter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["spatialized", "lastEventMs"],
      "properties": {
        "spatialized": { "type": "boolean" },
        "lastEventMs": { "$ref": "#/$defs/nonNegInt" }
      }
    }
  }
}