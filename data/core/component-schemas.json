{
  "version": 1,
  "meta": {
    "author": "alpha",
    "date": "2026-02-19T00:00:00Z",
    "notes": "MVP ECS component schemas for Sprint 1"
  },
  "units": {
    "tile_size_px": 16,
    "world_unit_per_tile": 1.0
  },
  "validation": {
    "required_component_keys": [
      "position",
      "velocity",
      "collider",
      "tile",
      "ore_vein",
      "health",
      "stamina",
      "damageable",
      "inventory",
      "tool",
      "faction",
      "sprite_ref",
      "light",
      "sound_emitter",
      "ui_state"
    ],
    "number_clamps_default": {
      "min": -1000000000,
      "max": 1000000000
    },
    "id_pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
  },
  "components": {
    "collider": {
      "id": "collider",
      "doc": "Axis-aligned bounding box collider (tiles). Offsets relative to position center.",
      "type": "object",
      "required": [
        "w",
        "h",
        "is_solid"
      ],
      "properties": {
        "w": {
          "type": "number",
          "min": 0
        },
        "h": {
          "type": "number",
          "min": 0
        },
        "offset_x": {
          "type": "number"
        },
        "offset_y": {
          "type": "number"
        },
        "is_solid": {
          "type": "boolean"
        },
        "is_sensor": {
          "type": "boolean"
        },
        "category": {
          "type": "integer",
          "min": 0
        },
        "mask": {
          "type": "integer",
          "min": 0
        }
      },
      "defaults": {
        "offset_x": 0,
        "offset_y": 0,
        "is_solid": true,
        "is_sensor": false,
        "category": 1,
        "mask": 4294967295
      },
      "clamps": {
        "w": {
          "min": 0,
          "max": 64
        },
        "h": {
          "min": 0,
          "max": 64
        }
      }
    },
    "damageable": {
      "id": "damageable",
      "doc": "Damage & poise tuning knobs",
      "type": "object",
      "required": [
        "defense"
      ],
      "properties": {
        "defense": {
          "type": "integer",
          "min": 0
        },
        "poise_max": {
          "type": "integer",
          "min": 0
        },
        "poise_current": {
          "type": "integer",
          "min": 0
        },
        "poise_recover_per_sec": {
          "type": "number",
          "min": 0
        },
        "poise_break_stun_ms": {
          "type": "integer",
          "min": 0
        }
      },
      "defaults": {
        "defense": 0,
        "poise_max": 0,
        "poise_current": 0,
        "poise_recover_per_sec": 0,
        "poise_break_stun_ms": 0
      }
    },
    "faction": {
      "id": "faction",
      "doc": "Faction alignment token",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        }
      }
    },
    "health": {
      "id": "health",
      "doc": "Health pool",
      "type": "object",
      "required": [
        "current",
        "max"
      ],
      "properties": {
        "current": {
          "type": "integer",
          "min": 0
        },
        "max": {
          "type": "integer",
          "min": 1
        },
        "regen_per_sec": {
          "type": "number",
          "min": 0
        }
      },
      "defaults": {
        "regen_per_sec": 0
      },
      "clamps": {
        "current": {
          "min": 0
        },
        "max": {
          "min": 1
        }
      }
    },
    "inventory": {
      "id": "inventory",
      "doc": "Simple slot-based inventory container",
      "type": "object",
      "required": [
        "slots"
      ],
      "properties": {
        "slots": {
          "type": "integer",
          "min": 0,
          "max": 64
        },
        "items": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "qty"
            ],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
              },
              "qty": {
                "type": "integer",
                "min": 1
              },
              "meta": {
                "type": "object",
                "nullable": true
              }
            }
          }
        },
        "weight_capacity": {
          "type": "number",
          "min": 0
        }
      },
      "defaults": {
        "items": [],
        "weight_capacity": 0
      },
      "notes": "Runtime may manage items externally; array here is allowed for data-driven actors/tools and tests."
    },
    "light": {
      "id": "light",
      "doc": "Point light parameters",
      "type": "object",
      "required": [
        "radius",
        "intensity"
      ],
      "properties": {
        "radius": {
          "type": "number",
          "min": 0
        },
        "intensity": {
          "type": "number",
          "min": 0,
          "max": 1
        },
        "color_token": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        }
      },
      "defaults": {
        "intensity": 1
      }
    },
    "ore_vein": {
      "id": "ore_vein",
      "doc": "Mineable ore vein metadata",
      "type": "object",
      "required": [
        "ore_id",
        "richness"
      ],
      "properties": {
        "ore_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        },
        "richness": {
          "type": "integer",
          "min": 0
        },
        "respawn_sec": {
          "type": "integer",
          "min": 0,
          "nullable": true
        }
      },
      "defaults": {
        "respawn_sec": null
      }
    },
    "position": {
      "id": "position",
      "doc": "World position in tiles (1.0 = 1 tile)",
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        }
      },
      "defaults": {
        "x": 0,
        "y": 0
      },
      "clamps": {
        "x": {
          "min": -1000000,
          "max": 1000000
        },
        "y": {
          "min": -1000000,
          "max": 1000000
        }
      }
    },
    "sound_emitter": {
      "id": "sound_emitter",
      "doc": "Sound trigger parameters (ambient or one-shots)",
      "type": "object",
      "required": [
        "sfx_tag",
        "loop",
        "cooldown_ms"
      ],
      "properties": {
        "sfx_tag": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        },
        "loop": {
          "type": "boolean"
        },
        "cooldown_ms": {
          "type": "integer",
          "min": 0
        }
      },
      "defaults": {
        "loop": false,
        "cooldown_ms": 0
      }
    },
    "sprite_ref": {
      "id": "sprite_ref",
      "doc": "Sprite/art reference and draw hints",
      "type": "object",
      "required": [
        "sprite_id"
      ],
      "properties": {
        "sprite_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        },
        "z": {
          "type": "integer"
        },
        "flip_x": {
          "type": "boolean"
        },
        "flip_y": {
          "type": "boolean"
        },
        "tint_token": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
          "nullable": true
        }
      },
      "defaults": {
        "z": 0,
        "flip_x": false,
        "flip_y": false,
        "tint_token": null
      }
    },
    "stamina": {
      "id": "stamina",
      "doc": "Stamina pool for actions",
      "type": "object",
      "required": [
        "current",
        "max"
      ],
      "properties": {
        "current": {
          "type": "number",
          "min": 0
        },
        "max": {
          "type": "number",
          "min": 0
        },
        "regen_per_sec": {
          "type": "number",
          "min": 0
        },
        "drain_mult": {
          "type": "number",
          "min": 0
        }
      },
      "defaults": {
        "regen_per_sec": 10,
        "drain_mult": 1
      },
      "clamps": {
        "current": {
          "min": 0
        },
        "max": {
          "min": 0,
          "max": 10000
        }
      }
    },
    "tile": {
      "id": "tile",
      "doc": "Tile marker for static world cells or embedded entity tiles",
      "type": "object",
      "required": [
        "tile_id",
        "solid"
      ],
      "properties": {
        "tile_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        },
        "solid": {
          "type": "boolean"
        },
        "material": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        },
        "hardness": {
          "type": "number",
          "min": 0
        }
      },
      "defaults": {
        "material": "mat.rock.generic",
        "hardness": 1
      }
    },
    "tool": {
      "id": "tool",
      "doc": "Equipped tool metadata",
      "type": "object",
      "required": [
        "tool_id",
        "tier"
      ],
      "properties": {
        "tool_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$"
        },
        "tier": {
          "type": "integer",
          "min": 0
        },
        "durability": {
          "type": "integer",
          "min": 0
        },
        "durability_max": {
          "type": "integer",
          "min": 0
        },
        "mining_power": {
          "type": "number",
          "min": 0
        },
        "attack_power": {
          "type": "number",
          "min": 0
        }
      },
      "defaults": {
        "durability": 0,
        "durability_max": 0,
        "mining_power": 0,
        "attack_power": 0
      }
    },
    "ui_state": {
      "id": "ui_state",
      "doc": "Minimal UI state hooks for entities or global proxy entity",
      "type": "object",
      "required": [],
      "properties": {
        "panel": {
          "type": "string",
          "pattern": "^[a-z0-9]+(\\.[a-z0-9_]+)+$",
          "nullable": true
        },
        "hotbar_selection": {
          "type": "integer",
          "min": 0,
          "max": 9
        },
        "minimap_enabled": {
          "type": "boolean"
        }
      },
      "defaults": {
        "panel": null,
        "hotbar_selection": 0,
        "minimap_enabled": true
      }
    },
    "velocity": {
      "id": "velocity",
      "doc": "World velocity in tiles/sec",
      "type": "object",
      "required": [
        "vx",
        "vy"
      ],
      "properties": {
        "vx": {
          "type": "number"
        },
        "vy": {
          "type": "number"
        },
        "max_speed": {
          "type": "number"
        }
      },
      "defaults": {
        "vx": 0,
        "vy": 0
      },
      "clamps": {
        "vx": {
          "min": -1000,
          "max": 1000
        },
        "vy": {
          "min": -1000,
          "max": 1000
        },
        "max_speed": {
          "min": 0,
          "max": 1000
        }
      }
    }
  }
}