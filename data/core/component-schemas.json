  "flags": {
    "TILE_FLAGS": {
      "ROOM_FLOOR": 1,
      "DOOR_BAND": 2,
      "ORE_PREF": 4,
      "LAMP_ANCHOR": 8,
      "APPROACH3W_PROTECT": 16
    },
    "mask_notes": [
      "Only bits defined in TILE_FLAGS may be set; others must remain 0.",
      "DOOR_BAND applies only to floor cells adjacent to candidate door openings.",
      "ROOM_FLOOR marks carved/valid floor cells for room placement and metrics.",
      "ORE_PREF biases cellular automata or placer toward ore retention in flagged cells.",
      "LAMP_ANCHOR designates cells valid for lamp placement; not all floor cells qualify.",
      "APPROACH3W_PROTECT marks approach corridors against over-smoothing during CA passes.",
      "Tile.flags must be non-negative."
    ]
  }
