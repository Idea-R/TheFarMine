# Discord Configuration
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_client_id_here
DISCORD_GUILD_ID=your_guild_id_here

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_ORG_ID=your_organization_id_here

# Database Configuration
DATABASE_URL=sqlite:///data/farmine.db
DATABASE_BACKUP_PATH=./backups/

# Agent Configuration
AGENT_BASE_PATH=./agents/
AGENT_LOG_LEVEL=INFO
AGENT_MAX_RETRIES=3

# Game Configuration
GAME_DATA_PATH=./data/game/
SAVE_PATH=./saves/
MAX_SAVE_FILES=10

# Security Configuration
JWT_SECRET=generate_a_secure_random_string_here
ENCRYPTION_KEY=generate_another_secure_key_here

# Development Configuration
DEBUG=false
LOG_LEVEL=INFO
LOG_PATH=./logs/

# API Configuration
API_RATE_LIMIT=100
API_TIMEOUT=30

# Image Generation
IMAGE_GEN_API_KEY=your_image_generation_api_key_here
IMAGE_STORAGE_PATH=./data/images/

# Agent Communication
AGENT_COMM_PORT=8080
AGENT_COMM_PROTOCOL=http
AGENT_COMM_TIMEOUT=60
